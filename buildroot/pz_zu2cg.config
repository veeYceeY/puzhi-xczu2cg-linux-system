# PZ-ZU2CG on top of Buildroot's configs/zynqmp_zcu102_defconfig (scripts/build_linux.sh
# merges: ZCU102 defconfig < this file < paths generated from the XSA).
# The ZCU102 defconfig supplies the AMD kernel / U-Boot / ATF / PMU firmware versions
# and their hashes, so they stay a combination Buildroot has tested.

# System
BR2_TARGET_GENERIC_HOSTNAME="pz-zu2cg"
BR2_TARGET_GENERIC_ISSUE="Welcome to PZ-ZU2CG"
BR2_TARGET_GENERIC_GETTY_PORT="ttyPS0"
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# board/zynqmp/post-build.sh writes extlinux.conf from these; the 4th argument is used by
# our post-image script. mmcblk1 = SD card (mmc1 = sdhci1, mmc0 = eMMC)
BR2_ROOTFS_POST_SCRIPT_ARGS="ttyPS0,115200 mmcblk1p2"

# Kernel: AMD's xilinx_defconfig plus the drivers this board needs; the board DTS
# directory is added by build_linux.sh
BR2_LINUX_KERNEL_INTREE_DTS_NAME=""

# U-Boot: device tree, PSU init, PM config and bitstream loading are board specific
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="DEVICE_TREE=pz-zu2cg"

# Tools for the board's peripherals. BusyBox already has devmem, lsusb and i2cdetect/get/set/dump.
# libgpiod v1, because v2 needs kernel headers >= 5.10 and the Bootlin stable toolchain has 5.4.
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_CAN_UTILS=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_NVME=y
BR2_PACKAGE_MMC_UTILS=y
BR2_PACKAGE_MTD=y
