/*
 * PZ-ZU2CG Linux reference design: board-level devices on the PL peripherals
 * Generated by tools/gen_pl_dts.py from projects/pz_zu2cg_linux/pz_zu2cg_linux.xsa
 * - do not edit; change the generator or the Vivado design and regenerate.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	leds {
		compatible = "gpio-leds";

		led1 {
			label = "led1";
			gpios = <&gpio_led 0 GPIO_ACTIVE_HIGH>;
		};

		led2 {
			label = "led2";
			gpios = <&gpio_led 1 GPIO_ACTIVE_HIGH>;
		};

		led3 {
			label = "led3";
			gpios = <&gpio_led 2 GPIO_ACTIVE_HIGH>;
		};

		led4 {
			label = "led4";
			gpios = <&gpio_led 3 GPIO_ACTIVE_HIGH>;
		};

		led5 {
			label = "led5";
			gpios = <&gpio_led 4 GPIO_ACTIVE_HIGH>;
		};

		core-led1 {
			label = "core-led1";
			gpios = <&gpio_led_core 0 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};

		core-led2 {
			label = "core-led2";
			gpios = <&gpio_led_core 1 GPIO_ACTIVE_HIGH>;
		};

		core-led3 {
			label = "core-led3";
			gpios = <&gpio_led_core 2 GPIO_ACTIVE_HIGH>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;

		key1 {
			label = "KEY1";
			linux,code = <BTN_0>;
			gpios = <&gpio_key 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <20>;
		};

		key2 {
			label = "KEY2";
			linux,code = <BTN_1>;
			gpios = <&gpio_key 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <20>;
		};

		key3 {
			label = "KEY3";
			linux,code = <BTN_2>;
			gpios = <&gpio_key 2 GPIO_ACTIVE_LOW>;
			debounce-interval = <20>;
		};

		key4 {
			label = "KEY4";
			linux,code = <BTN_3>;
			gpios = <&gpio_key 3 GPIO_ACTIVE_LOW>;
			debounce-interval = <20>;
		};

		key5 {
			label = "KEY5";
			linux,code = <BTN_4>;
			gpios = <&gpio_key 4 GPIO_ACTIVE_LOW>;
			debounce-interval = <20>;
		};
	};
};

&axi_iic_eeprom {
	eeprom@50 {
		compatible = "atmel,24c64";
		reg = <0x50>;
		pagesize = <32>;
	};
};

/*
 * RTL8211F on the PL RGMII port (the Puzhi manual says KSZ9031, but the PHY ID registers
 * read 0x001c/0xc916). The gmii_to_rgmii core adds no clock skew (its MMCM outputs are
 * all at 0 degrees), so the PHY must add both RGMII delays. The Realtek driver sets them
 * only for rgmii* modes, so GEM1 is described as rgmii-id even though it talks GMII to the
 * core: on ZynqMP that only changes a USRIO write, which GEM0 (RGMII on MIO) also does.
 * Checked on hardware for GEM0 only (2026-11-14); the PL port is still untested.
 * The PHY is held in reset by EMIO GPIO 0 (PS GPIO line 78) until Linux releases it,
 * so its ID can't be probed: the compatible names it.
 */
&gem1 {
	phy-mode = "rgmii-id";
	phy-handle = <&phy_pl>;
};

&gem1_mdio {
	phy_pl: ethernet-phy@2 {
		compatible = "ethernet-phy-id001c.c916", "ethernet-phy-ieee802.3-c22";
		reg = <2>;
		reset-gpios = <&gpio 78 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <1000>;
	};
};

&gmii_to_rgmii_0 {
	phy-handle = <&phy_pl>;
};

/* JM1 header: GPIO line = connector pin */
&gpio_jm1 {
	gpio-line-names = "JM1-5", "JM1-6", "JM1-7", "JM1-8", "JM1-9", "JM1-10", "JM1-11", "JM1-12",
		"JM1-13", "JM1-14", "JM1-15", "JM1-16", "JM1-17", "JM1-18", "JM1-19", "JM1-20",
		"JM1-21", "JM1-22", "JM1-23", "JM1-24", "JM1-25", "JM1-26", "JM1-27", "JM1-28",
		"JM1-29", "JM1-30", "JM1-31", "JM1-32", "JM1-37", "JM1-38", "JM1-39", "JM1-40";
};

/* J19 header: GPIO line = connector pin */
&gpio_j19 {
	gpio-line-names = "J19-9", "J19-10", "J19-11", "J19-12", "J19-15", "J19-16", "J19-17", "J19-18",
		"J19-21", "J19-22", "J19-23", "J19-24", "J19-27", "J19-28", "J19-29", "J19-30",
		"J19-33", "J19-34", "J19-35", "J19-36", "J19-39", "J19-40", "J19-41", "J19-42",
		"J19-45", "J19-46", "J19-47", "J19-48", "J19-51", "J19-52", "J19-53", "J19-54";
};

/* J20 header: GPIO line = connector pin */
&gpio_j20 {
	gpio-line-names = "J20-9", "J20-10", "J20-11", "J20-12", "J20-15", "J20-16", "J20-17", "J20-18",
		"J20-21", "J20-22", "J20-23", "J20-24", "J20-27", "J20-28", "J20-29", "J20-30",
		"J20-33", "J20-34", "J20-35", "J20-36", "J20-39", "J20-40", "J20-41", "J20-42",
		"J20-45", "J20-46", "J20-47", "J20-48", "J20-51", "J20-52", "J20-53", "J20-54",
		"J20-57", "J20-58", "J20-59", "J20-60", "J20-63", "J20-64", "J20-65", "J20-66",
		"J20-69", "J20-70", "J20-71", "J20-72", "J20-75", "J20-76", "J20-77", "J20-78";
};
